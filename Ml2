local function formatNumber(number)
    local suffixes = {
        {1e15, "Qa"}, {1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}
    }
    for _, suffix in ipairs(suffixes) do
        if math.abs(number) >= suffix[1] then
            return string.format("%.2f%s", number / suffix[1], suffix[2])
        end
    end
    return tostring(math.floor(number))
end

local timeHeader = AutoRebirt:AddLabel("Estadísticas de Renacimientos")
timeHeader.TextSize = 18
local uptimeLabel = AutoRebirt:AddLabel("Tiempo: 0d 0h 0m 0s")
local paceLabel = AutoRebirt:AddLabel("Ritmo: 0 / Hora | 0 / Día | 0 / Sem.")
local avgPaceLabel = AutoRebirt:AddLabel("Promedio: 0 / Hora | 0 / Día | 0 / Sem.")
local rebirthsInfoLabel = AutoRebirt:AddLabel("Renacimientos: 0 | Ganados: 0")

local startTime = tick()
local initialRebirths = rebirthsStat.Value
local rebirthHistory = {}
local totalRebirthsGained = 0

local function updateRebirthUI()
    local current = rebirthsStat.Value
    totalRebirthsGained = current - initialRebirths
    rebirthsInfoLabel.Text = "Renacimientos: " .. formatNumber(current) .. " | Ganados: " .. formatNumber(totalRebirthsGained)
end

rebirthsStat.Changed:Connect(updateRebirthUI)
updateRebirthUI()

task.spawn(function()
    while true do
        local now = tick()
        local elapsed = now - startTime

        local days = math.floor(elapsed / 86400)
        local hours = math.floor((elapsed % 86400) / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = math.floor(elapsed % 60)
        uptimeLabel.Text = string.format("Tiempo: %dd %dh %dm %ds", days, hours, minutes, seconds)
        
        table.insert(rebirthHistory, {time = now, value = rebirthsStat.Value})
        
        while #rebirthHistory > 0 and now - rebirthHistory[1].time > 3600 do
            table.remove(rebirthHistory, 1)
        end

        if #rebirthHistory >= 2 then
            local rDelta = rebirthHistory[#rebirthHistory].value - rebirthHistory[1].value
            local tDelta = rebirthHistory[#rebirthHistory].time - rebirthHistory[1].time
            if tDelta > 0 then
                local perSec = rDelta / tDelta
                paceLabel.Text = string.format("Ritmo: %s/Hora | %s/Día | %s/Sem.", 
                    formatNumber(perSec * 3600), formatNumber(perSec * 86400), formatNumber(perSec * 604800))
            end
        end

        if elapsed > 0 then
            local avgPerSec = totalRebirthsGained / elapsed
            avgPaceLabel.Text = string.format("Promedio: %s/Hora | %s/Día | %s/Sem.", 
                formatNumber(avgPerSec * 3600), formatNumber(avgPerSec * 86400), formatNumber(avgPerSec * 604800))
        end

        task.wait(1) 
    end
end)

